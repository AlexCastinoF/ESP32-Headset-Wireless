<Window x:Class="HeadsetManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Headset Wireless"
        Width="980" Height="660"
        MinWidth="860" MinHeight="560"
        Background="{StaticResource Paper}"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource Sidebar}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="20,22,16,18">
          <TextBlock Text="HEADSET" Foreground="#8FBFB8" FontSize="11" FontWeight="SemiBold"/>
          <TextBlock Text="Wireless" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"/>
          <TextBlock x:Name="SidebarLink" Text="Dongle ausente" Foreground="#D5E4E2" Margin="0,8,0,0"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="Revisão B · 48 kHz" Foreground="#7E9490" Margin="20,0,16,18" FontSize="12"/>
        <StackPanel>
          <Button x:Name="NavHome" Content="Início" Style="{StaticResource NavButton}" Click="Nav_Click"/>
          <Button x:Name="NavAudio" Content="Áudio" Style="{StaticResource NavButton}" Click="Nav_Click"/>
          <Button x:Name="NavTransport" Content="Transporte" Style="{StaticResource NavButton}" Click="Nav_Click"/>
          <Button x:Name="NavRadio" Content="Rádio" Style="{StaticResource NavButton}" Click="Nav_Click"/>
          <Button x:Name="NavDiag" Content="Diagnóstico" Style="{StaticResource NavButton}" Click="Nav_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="24,20,24,16">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
          <StackPanel x:Name="PageHome">
            <TextBlock Text="Estado" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="DONGLE" Style="{StaticResource Label}"/>
                  <TextBlock x:Name="DongleState" Text="Ausente" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="FONE" Style="{StaticResource Label}"/>
                  <TextBlock x:Name="LinkValue" Text="Sem enlace" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="BATERIA" Style="{StaticResource Label}"/>
                <TextBlock x:Name="BatteryValue" Text="—" FontSize="16" Margin="0,0,0,6"/>
                <ProgressBar x:Name="BatteryBar" Height="10" Minimum="0" Maximum="100" Value="0"/>
                <TextBlock Text="SINAL" Style="{StaticResource Label}" Margin="0,14,0,4"/>
                <StackPanel Orientation="Horizontal">
                  <Border x:Name="Bar1" Width="14" Height="8" Margin="0,16,4,0" CornerRadius="2" Background="#D5DDE4" VerticalAlignment="Bottom"/>
                  <Border x:Name="Bar2" Width="14" Height="14" Margin="0,10,4,0" CornerRadius="2" Background="#D5DDE4" VerticalAlignment="Bottom"/>
                  <Border x:Name="Bar3" Width="14" Height="20" Margin="0,4,4,0" CornerRadius="2" Background="#D5DDE4" VerticalAlignment="Bottom"/>
                  <Border x:Name="Bar4" Width="14" Height="26" Margin="0,0,4,0" CornerRadius="2" Background="#D5DDE4" VerticalAlignment="Bottom"/>
                  <Border x:Name="Bar5" Width="14" Height="32" CornerRadius="2" Background="#D5DDE4" VerticalAlignment="Bottom"/>
                  <TextBlock x:Name="RssiValue" Text="Sem sinal" Margin="12,8,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <UniformGrid Columns="3" Margin="0,14,0,0">
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="POTÊNCIA" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="PowerValue" Text="—" FontSize="16"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="PACOTES PERDIDOS" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="LossValue" Text="—" FontSize="16"/>
                    <TextBlock Text="a cada mil no rádio" Foreground="{StaticResource Muted}" FontSize="11"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="IDA E VOLTA" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="RttValue" Text="—" FontSize="16"/>
                  </StackPanel>
                </UniformGrid>
                <TextBlock x:Name="MuteValue" Text="Mudo solto" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
                <TextBlock x:Name="VersionValue" Text="Firmware —" Foreground="{StaticResource Muted}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <RadioButton x:Name="ModeBars" Content="Barras" IsChecked="True" Margin="0,0,12,0" Checked="MeterMode_Checked"/>
                    <RadioButton x:Name="ModeSpectrum" Content="Espectro" Checked="MeterMode_Checked"/>
                  </StackPanel>
                  <TextBlock Text="SOM AO VIVO" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel x:Name="HomeBars" Margin="0,8,0,0">
                  <TextBlock x:Name="HomeLeftLabel" Text="Alto-falante esquerdo  0%" Margin="0,0,0,4"/>
                  <ProgressBar x:Name="HomeLeftMeter" Height="14" Minimum="0" Maximum="100"/>
                  <TextBlock x:Name="HomeRightLabel" Text="Alto-falante direito  0%" Margin="0,10,0,4"/>
                  <ProgressBar x:Name="HomeRightMeter" Height="14" Minimum="0" Maximum="100"/>
                  <TextBlock x:Name="HomeMicLabel" Text="Microfone  0%" Margin="0,10,0,4"/>
                  <ProgressBar x:Name="HomeMicMeter" Height="14" Minimum="0" Maximum="100"/>
                </StackPanel>
                <Canvas x:Name="HomeSpectrum" Height="120" Margin="0,8,0,0" Visibility="Collapsed" Background="#F7FAFB"/>
                <TextBlock x:Name="SpectrumLegend" Visibility="Collapsed" Margin="0,6,0,0" Foreground="{StaticResource Muted}" Text="Verde esquerdo · laranja direito · azul microfone. Da esquerda para a direita, grave até agudo."/>
                <CheckBox x:Name="TrayIcons" Content="Mostrar na área de notificação, ao lado do volume" IsChecked="True" Margin="0,12,0,0" Checked="TrayIcons_Changed" Unchecked="TrayIcons_Changed"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Testes" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Text="O teste de enlace olha se o fone responde, a força do sinal e as perdas. O tom de 1 kHz sai no alto-falante por 3 segundos. No teste do clique, fale um estalo no microfone e ouça o retorno: no perfil Equilíbrio a ida e volta fica entre 55 e 85 ms."/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button x:Name="LinkTestButton" Content="Testar enlace" Padding="12,6" Margin="0,0,8,0" Click="LinkTest_Click"/>
                  <Button x:Name="ToneTestButton" Content="Tom de 1 kHz" Padding="12,6" Click="ToneTest_Click"/>
                </StackPanel>
                <TextBlock x:Name="TestResult" Text="Nenhum teste rodou ainda." Margin="0,12,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <CheckBox x:Name="StartWithWindows" Content="Iniciar com o Windows" Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed"/>
          </StackPanel>

          <StackPanel x:Name="PageAudio" Visibility="Collapsed">
            <TextBlock Text="Áudio" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <RadioButton x:Name="AudioModeBars" Content="Barras" IsChecked="True" Margin="0,0,12,0" Checked="MeterMode_Checked"/>
                    <RadioButton x:Name="AudioModeSpectrum" Content="Espectro" Checked="MeterMode_Checked"/>
                  </StackPanel>
                  <TextBlock Text="SOM AO VIVO" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="LiveHint" Text="As barras seguem o que o Windows envia ao dongle e o que o microfone devolve." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,8"/>
                <StackPanel x:Name="AudioBars">
                  <TextBlock x:Name="AudioLeftLabel" Text="Alto-falante esquerdo  0%" Margin="0,4,0,4"/>
                  <ProgressBar x:Name="AudioLeftMeter" Height="16" Minimum="0" Maximum="100"/>
                  <TextBlock x:Name="AudioRightLabel" Text="Alto-falante direito  0%" Margin="0,10,0,4"/>
                  <ProgressBar x:Name="AudioRightMeter" Height="16" Minimum="0" Maximum="100"/>
                  <TextBlock x:Name="AudioMicLabel" Text="Microfone  0%" Margin="0,10,0,4"/>
                  <ProgressBar x:Name="AudioMicMeter" Height="16" Minimum="0" Maximum="100"/>
                </StackPanel>
                <Canvas x:Name="AudioSpectrum" Height="150" Visibility="Collapsed" Background="#F7FAFB"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock x:Name="SpeakerLabel" Text="Alto-falante  100%" Style="{StaticResource Label}"/>
                <Slider x:Name="SpeakerSlider" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="VolumeSlider_Changed"/>
                <TextBlock x:Name="MicLabel" Text="Microfone  100%" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                <Slider x:Name="MicSlider" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="VolumeSlider_Changed"/>
                <TextBlock x:Name="VolumeHint" Text="Com o dongle enumerado, o volume move o endpoint do Windows e o ganho do firmware fica em 0 dB." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock x:Name="SidetoneLabel" Text="Retorno da própria voz  desligado" Style="{StaticResource Label}"/>
                <Slider x:Name="SidetoneSlider" Minimum="-60" Maximum="0" Value="-60" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FirmwareSlider_Changed"/>
                <TextBlock x:Name="BoostLabel" Text="Avanço do microfone  0 dB" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                <Slider x:Name="BoostSlider" Minimum="0" Maximum="24" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FirmwareSlider_Changed"/>
                <TextBlock Text="O INMP441 é quieto. O avanço só existe no firmware, misturado no fone junto com o retorno." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <CheckBox x:Name="MuteBox" Content="Mudo do microfone" Margin="0,0,24,0" Checked="Flag_Changed" Unchecked="Flag_Changed"/>
                  <CheckBox x:Name="ToneBox" Content="Tom de teste 1 kHz" Checked="Flag_Changed" Unchecked="Flag_Changed"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="PageTransport" Visibility="Collapsed">
            <TextBlock Text="Transporte" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <RadioButton x:Name="ProfileGame" Content="Jogo  ·  quadro de 5 ms, buffer de 1" GroupName="profile" Margin="0,0,0,8" Checked="Profile_Checked"/>
                <RadioButton x:Name="ProfileBalance" Content="Equilíbrio  ·  quadro de 5 ms, buffer de 2" GroupName="profile" Margin="0,0,0,8" IsChecked="True" Checked="Profile_Checked"/>
                <RadioButton x:Name="ProfileStable" Content="Estável  ·  quadro de 10 ms, buffer de 2" GroupName="profile" Checked="Profile_Checked"/>
                <TextBlock x:Name="LatencyPreview" Text="Ida estimada 27 ms · ida e volta 62 ms" Margin="0,14,0,0" FontWeight="SemiBold"/>
                <TextBlock Text="O dongle só troca o quadro depois que o fone confirma. Até lá os dois lados continuam no modo anterior." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <CheckBox x:Name="AdvancedTransport" Content="Ajuste avançado" Checked="Advanced_Changed" Unchecked="Advanced_Changed"/>
                <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Margin="0,12,0,0">
                  <TextBlock Text="QUADRO" Style="{StaticResource Label}"/>
                  <ComboBox x:Name="FrameBox" Width="160" HorizontalAlignment="Left" SelectionChanged="CustomTransport_Changed">
                    <ComboBoxItem Content="5 ms" Tag="5" IsSelected="True"/>
                    <ComboBoxItem Content="10 ms" Tag="10"/>
                  </ComboBox>
                  <TextBlock Text="BUFFER" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                  <ComboBox x:Name="JitterBox" Width="160" HorizontalAlignment="Left" SelectionChanged="CustomTransport_Changed">
                    <ComboBoxItem Content="1 quadro" Tag="1"/>
                    <ComboBoxItem Content="2 quadros" Tag="2" IsSelected="True"/>
                    <ComboBoxItem Content="3 quadros" Tag="3"/>
                  </ComboBox>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="PageRadio" Visibility="Collapsed">
            <TextBlock Text="Rádio" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="FONE" Style="{StaticResource Label}"/>
                <RadioButton x:Name="MacPreset" GroupName="Peer" IsChecked="True" Margin="0,4,0,12" Checked="MacChoice_Changed">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="48" Height="48" CornerRadius="24" Background="#E6F4F2">
                      <TextBlock Text="&#xE7F6;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource Teal}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="Fone C3" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                      <TextBlock Text="90:DA:72:84:B0:20" FontFamily="Consolas" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="MacCustom" GroupName="Peer" Content="MAC personalizado" Checked="MacChoice_Changed"/>
                <TextBox x:Name="MacBox" Width="220" HorizontalAlignment="Left" Padding="8,6" Margin="0,8,0,0" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="CANAL" Style="{StaticResource Label}"/>
                <ComboBox x:Name="ChannelBox" Width="160" HorizontalAlignment="Left" SelectionChanged="Channel_Changed"/>
                <TextBlock x:Name="PowerLabel" Text="Potência  15,0 dBm" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                <Slider x:Name="PowerSlider" Minimum="8" Maximum="80" Value="60" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="PowerSlider_Changed"/>
                <Button x:Name="SaveRadioButton" Content="Gravar no dongle" Width="160" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="8,6" Click="SaveRadio_Click"/>
                <TextBlock Text="O card do fone já manda o MAC do C3. O campo personalizado é para outro aparelho. Canal livre, perto de 15 dBm." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="PageDiag" Visibility="Collapsed">
            <TextBlock Text="Diagnóstico" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="RSSI e perdas, últimas amostras" Style="{StaticResource Label}"/>
                <Canvas x:Name="Plot" Height="160" Background="#F7FAFB"/>
                <TextBlock x:Name="PlotCaption" Text="Aguardando amostras." Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Teste do clique" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" Text="Com o perfil Equilíbrio, dê um clique seco na frente do microfone e ouça o retorno no fone. A ida e volta esperada fica entre 55 e 85 ms. Abaixo disso o buffer está curto e uma perda aparece como um corte. Acima de 85 ms, o quadro ou o buffer estão maiores do que o necessário para conversa."/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <Border x:Name="EmptyState" Background="#F4F7F8" Visibility="Visible">
        <Border Style="{StaticResource Card}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28" MaxWidth="420">
          <StackPanel>
            <TextBlock Text="Conecte o dongle no USB nativo" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource Muted}"
                       Text="Use o conector USB do S3, não o UART/COM da gravação. Quando o Windows mostrar o alto-falante Headset Wireless, esta tela abre o estado do fone: enlace, bateria, sinal e testes."/>
          </StackPanel>
        </Border>
      </Border>

      <TextBlock x:Name="StatusLine" VerticalAlignment="Bottom" Foreground="{StaticResource Muted}" FontSize="12" Text="Procurando o dongle…"/>
    </Grid>
  </Grid>
</Window>
